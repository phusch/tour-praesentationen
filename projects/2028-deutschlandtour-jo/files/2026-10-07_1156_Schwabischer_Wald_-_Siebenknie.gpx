      <desc>Tag 1 | Rolle: shaping | Schwäbisch-Fränkischer Wald statt schneller Hauptachse</desc>
      <type>shaping</type>
    </rtept>
    <rtept lat="49.377500" lon="10.178000">
      <name>Rothenburg ob der Tauber</name>
